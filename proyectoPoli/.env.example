# Base de datos (Docker)
POSTGRES_USER=segupak
POSTGRES_PASSWORD=segupak_secret
POSTGRES_DB=segupak_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Django (copiar a backend/config/.env para desarrollo)
DJANGO_SECRET_KEY=change-me-in-production-use-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Solicitudes: costo_promedio >= este umbral implica aprobación por Gerencia (además del camino Compras con stock)
GERENCIA_COSTO_UMBRAL=10000.00

# URL del backend para el frontend (sin barra final)
API_URL=http://localhost:8000
