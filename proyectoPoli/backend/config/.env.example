# Copiar a .env y ajustar valores (DJANGO_SECRET_KEY es obligatoria; no hay valor por defecto en settings)
DJANGO_SECRET_KEY=change-me-in-production
# En desarrollo use DEBUG=1 para que runserver sirva CSS/JS del admin en /static/.
# Con DEBUG=0 el HTML del admin carga pero los estilos no: use `python manage.py runserver --insecure`
# o ejecute collectstatic + un servidor de estáticos.
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes permitidos para CSRF (login admin, formularios). Incluya el host:puerto que use en el navegador.
# CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Si Docker está en localhost (por defecto)
POSTGRES_USER=segupak
POSTGRES_PASSWORD=segupak_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=segupak_db

DATABASE_URL=postgres://segupak:segupak_secret@localhost:5432/segupak_db

REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Correo (notificaciones solicitudes, Release 1) ---
# Por defecto en settings.py: consola (no sale a internet). Para recibir en bandeja real:
#
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=Segupak <noreply@tu-dominio.com>
# EMAIL_HOST=smtp.tu-proveedor.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
#
# Algunos hosts usan puerto 465 + SSL en vez de TLS 587:
# EMAIL_PORT=465
# EMAIL_USE_TLS=0
# EMAIL_USE_SSL=1
#
# Gmail: suele requerir "contraseña de aplicación"; SMTP smtp.gmail.com:587 + TLS.
# Tras cambiar .env: reiniciar runserver.
